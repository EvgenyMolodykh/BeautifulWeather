<Window x:Class="WeatherAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource MainWindowTitle}" 
        Height="550" 
        Width="850"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:WeatherAppWPF.ViewModels"
        xmlns:homeView="clr-namespace:WeatherAppWPF.Views.Home" 
        xmlns:locationView="clr-namespace:WeatherAppWPF.Views.Location"
        xmlns:settingViev="clr-namespace:WeatherAppWPF.Views.Settings"
        xmlns:converters="clr-namespace:WeatherAppWPF.Resources.Converters"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewViewModel}">
            <homeView:HomeView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationViewViewModel}">
            <locationView:LocationView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingVievViewModel}">
            <settingViev:SettingView DataContext="{Binding}"/>
        </DataTemplate>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>

        <Border Background="{DynamicResource DayMainWindowGradient}"
                CornerRadius="20" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="20"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Label Style="{StaticResource HeadersPanel}" 
                       Content="Wather"
                       Margin="280,0,0,0"/>
                <Popup 
                        PlacementTarget="{Binding ElementName=UserMenuToggleButton}"
                        Placement="Relative"
                        HorizontalOffset="-220"
                        VerticalOffset="0"
                        IsOpen="{Binding IsChecked, ElementName=UserMenuToggleButton}"
                        StaysOpen="False"
                        AllowsTransparency="True"
                        PopupAnimation="None"
                        Focusable="True">
                    <Border Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="0,0,10,10"
                            Padding="5">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" Opacity="0.3" BlurRadius="8"/>
                        </Border.Effect>
                        <Grid Width="200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label x:Name="PersonalDesk_Label" 
                                   Grid.Row="0"
                                   Content="{DynamicResource Account}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                            <Label x:Name="LoginName_Label" 
                                    Grid.Column="2" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center"
                                    Content="{Binding LoginNameLabelContent}" />

                            <Button x:Name="SingOut_Button"
                                    Grid.Row="1"
                                    Content="{DynamicResource Exit}"
                                    Command="{Binding SingOutCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="2"
                                    Padding="5"
                                    Cursor="Hand"/>
                            <Button x:Name="SingIn_Button" 
                                    Grid.Row="2"
                                    Content="{DynamicResource Login}"
                                    Command="{Binding SingInCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="2"
                                    Padding="5"
                                    Cursor="Hand"
                                    Visibility="{Binding SingInButtonIsVisible, Converter={StaticResource BoolToVisibilityConverter }}"/>
                            <Button x:Name="Register_Button"
                                    Grid.Row="3"
                                    Content="{DynamicResource Registration}"
                                    Command="{Binding RegisterCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="2"
                                    Padding="5"
                                    Cursor="Hand"
                                    Visibility="{Binding RegisterButton, Converter={StaticResource BoolToVisibilityConverter }}"/>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Height="30"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <Grid Grid.Row="0" 
                  Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0">

                <!-- кнопка /// -->
                <Border Background="White" 
                        CornerRadius="0,0,8,8" 
                        Height="30" Width="35" 
                        Margin="-150,0,0,0">
                    <Grid>
                        <ToggleButton x:Name="UserMenuToggleButton"
                          Width="30" 
                          Height="30"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          ToolTip="Меню управления пользователем">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Image Source="{StaticResource menuMainDrawingImage}" 
                                           Width="23" 
                                           Margin="-2,0,0,0"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- Кнопки _ □ × -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="8,0,0,8" Height="20" Width="30">
                        <Button Background="Transparent"
                                Cursor="Hand"
                                BorderThickness="0"
                                Command="{Binding CollapceAppCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="-"/>
                    </Border>
                    <Border Background="White" Height="20" Width="30">
                        <Button Background="Transparent"
                                Cursor="Hand"
                                BorderThickness="0"
                                Content="□"
                                Command="{Binding FullScreenCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Border>
                    <Border Background="White" CornerRadius="0,8,8,0" Height="20" Width="30">
                        <Button Background="Transparent"
                                Cursor="Hand"
                                BorderThickness="0"
                                Content="×"
                                Command="{Binding CloseCommand}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="UpdateDataButton"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="120,0,0,0"
                        Padding="0"
                        Grid.Column="0"
                        Height="20"
                        Width="20"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Image Source="{StaticResource updateDrawingImage}"/>
                </Button>

                <Label x:Name="MonitoringPeiod_Label" 
                       Grid.Column="1" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="20" Background="White" Width="40" Height="250" Margin="0,0,0,80">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Style="{StaticResource LeftPanel}">
                            <Button ToolTip="Главная страница"
                                    Cursor="Hand"
                                    Style="{StaticResource LeftPanelButton}" 
                                    Command="{Binding HomeCommand}">
                                <Image Source="{StaticResource homeDrawingImage}" Width="20" Margin="-10,0,0,0"/>
                            </Button>

                            <Button ToolTip="Выбор локации"
                                    Cursor="Hand"
                                    Style="{StaticResource LeftPanelButton}" 
                                    Command="{Binding LocationCommand}">
                                <Image Source="{StaticResource locationDrawingImage}" Width="30" Margin="-10,-20,0,0"/>
                            </Button>

                            <StackPanel Margin="0,50,0,0">
                                <Button ToolTip="Настройки"
                                        Cursor="Hand"
                                        Style="{StaticResource LeftPanelButton}"
                                        Command="{Binding SettingsCommand}">
                                    <Image Source="{StaticResource settingDrawingImage}" Width="30" Margin="-10,25,0,0"/>
                                </Button>

                                <Button ToolTip="Выход"
                                        Cursor="Hand"
                                        Style="{StaticResource LeftPanelButton}"
                                        Command="{Binding CloseCommand}">
                                    <Image Source="{StaticResource outDrawingImage}" 
                                           Width="15" 
                                           Margin="-10,0,0,10"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>