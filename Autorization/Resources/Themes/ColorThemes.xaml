<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="DayMainWindowGradient" StartPoint="0,0" EndPoint="1,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FF3333" Offset="0"/>
            <GradientStop Color="#FF9933" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LeftMainWindowBackground" Color="NavajoWhite"/>
    <SolidColorBrush x:Key="DayFarecastDetailsView" Color="WhiteSmoke"/>
   
    <SolidColorBrush x:Key="PagesTipsForeground" Color="LightCyan"/>
    <SolidColorBrush x:Key="MainForeground" Color="Black"/>
</ResourceDictionary>