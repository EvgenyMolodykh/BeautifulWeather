<ToggleButton x:Class="WeatherAppWPF.Resources.Controls.CustomToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherAppWPF.Resources.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ToggleButton.Template>
        <ControlTemplate TargetType="{x:Type local:CustomToggleButton}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                
                <Border x:Name="BorderC"
                        Background="#FFD97706"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="5,1,1,5" >
                    <TextBlock x:Name="TextC" 
                               Text="{TemplateBinding LeftCase}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="BorderF"
                        Background="White"
                        BorderBrush="Black" 
                        BorderThickness="0"
                        CornerRadius="1,5,5,1" >
                    <TextBlock x:Name="TextF" 
                               Text="{TemplateBinding RightCase}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter TargetName="BorderC" Property="Background" Value="White"/>
                    <Setter TargetName="BorderF" Property="Background" Value="#FFD97706"/>

                    <Setter TargetName="BorderC" Property="BorderBrush" Value="Black"/>
                    <Setter TargetName="BorderC" Property="BorderThickness" Value="1"/>

                    <Setter TargetName="TextC" Property="Foreground" Value="Black"/>
                    <Setter TargetName="TextF" Property="Foreground" Value="White"/>

                    <Setter TargetName="TextC" Property="Style" Value="{StaticResource TextBlockStyleOff}"/>
                    <Setter TargetName="TextF" Property="Style" Value="{StaticResource TextBlockStyleOn}"/>
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BorderC" Property="Background" Value="#FFD97706"/>
                    <Setter TargetName="BorderF" Property="Background" Value="White"/>

                    <Setter TargetName="BorderC" Property="BorderBrush" Value="Black"/>
                    <Setter TargetName="BorderC" Property="BorderThickness" Value="0"/>
                    <Setter TargetName="BorderF" Property="BorderThickness" Value="1"/>

                    <Setter TargetName="TextC" Property="Foreground" Value="White"/>
                    <Setter TargetName="TextF" Property="Foreground" Value="Black"/>

                    <Setter TargetName="TextC" Property="Style" Value="{StaticResource TextBlockStyleOn}"/>
                    <Setter TargetName="TextF" Property="Style" Value="{StaticResource TextBlockStyleOff}"/>
                </Trigger>
            </ControlTemplate.Triggers>

        </ControlTemplate>

    </ToggleButton.Template>
</ToggleButton>
