<UserControl x:Class="WeatherAppWPF.Views.Settings.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherAppWPF.Views.Settings"
             xmlns:controls="clr-namespace:WeatherAppWPF.Resources.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="{DynamicResource SettingsTitle}" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="10,10,0,0" 
                       HorizontalAlignment="Center" 
                       Foreground="White"/>
        </Grid>

        <Line X1="10" 
              Y1="35" 
              X2="850"
              Y2="35" 
              Stroke="White" 
              StrokeThickness="1" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border BorderBrush="#FFFFFF" 
                        BorderThickness="2" 
                        CornerRadius="7"
                        Margin="90,10,90,10"
                        Padding="10" 
                        Background="White" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="427*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{StaticResource speed_svgrepo_comDrawingImage}" 
                                    Width="60" 
                                    Height="28"
                                    DockPanel.Dock="Left" />
                                <Label Content="{DynamicResource WindSpeedMenuSetting}" 
                                       HorizontalAlignment="Left"/>
                                
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <ComboBox Name="WerterSpeed_Combobox" 
                                       SelectedItem="{Binding WindSpeed}">
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <Border BorderBrush="#FFFFFF" 
                        BorderThickness="2" 
                        CornerRadius="7"
                        Margin="90,10,90,10"
                        Padding="10" 
                        Background="White" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="427*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{StaticResource gauge_indicator_svgrepo_comDrawingImage}" 
                                        Width="60" 
                                        Height="30"
                                        DockPanel.Dock="Left" />
                                <Label Content="{DynamicResource PressureMenuSetting}" 
                                       Margin="-15,0,0,0"/>
                                <!--<ComboBox Name="Pressure_Combobox" 
                                          SelectedItem="{Binding Pressure}">
                                </ComboBox>-->
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
   
                                <controls:CustomToggleButton
                                            IsChecked="{Binding PressureController, Mode=TwoWay}" 
                                            Height="30"
                                            LeftCase="mmHg"
                                            RightCase="HPa">
                                </controls:CustomToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Border BorderBrush="#FFFFFF" 
                        BorderThickness="2" 
                        CornerRadius="7"
                        Margin="90,10,90,10"
                        Padding="10" 
                        Background="White" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="427*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{StaticResource storm_svgrepo_comDrawingImage}" 
                                    Width="60" 
                                    Height="28"
                                    DockPanel.Dock="Left" />
                                <Label Content="{DynamicResource MeasurementMenuSetting}" 
                                       Margin="-15,0,0,0"/>
                                <ComboBox Name="Precipitation_Combobox" 
                                          SelectedItem="{Binding Precipitation}">
                                </ComboBox>
                            </DockPanel>
                            
                        </Grid>

                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="mm" 
                                Width="50" 
                                Height="30" 
                                Background="#FFD97706" 
                                Foreground="White" 
                                BorderBrush="#FFD97706" 
                                BorderThickness="1"/>
                                <Button Content="inch" 
                                Width="50" 
                                Height="30" 
                                Background="White" 
                                Foreground="Black" 
                                BorderBrush="Gray" 
                                BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="3">
                <Border BorderBrush="#FFFFFF" 
                        BorderThickness="2" 
                        CornerRadius="7"
                        Margin="90,10,90,10"
                        Padding="10" 
                        Background="White" 
                        Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="427*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{StaticResource temperature_thermometer_svgrepo_comDrawingImage}" 
                                        Width="60" 
                                        Height="20"
                                        DockPanel.Dock="Left" />
                                <Label Content="{DynamicResource TemperatureMeasurementMenuSetting}" 
                                       Margin="-15,0,0,0"/>
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <controls:CustomToggleButton
                                        IsChecked="{Binding TemperatureController,Mode=TwoWay}"
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Right" 
                                        Height="30"
                                        LeftCase="{DynamicResource Celsius}"
                                        RightCase="{DynamicResource Fahrenheit}">
                                </controls:CustomToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="4">
                <Border BorderBrush="#FFFFFF" 
            BorderThickness="2" 
            CornerRadius="7"
            Margin="90,10,90,10"
            Padding="10" 
            Background="White" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="427*"/>
                            <ColumnDefinition Width="373*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <DockPanel VerticalAlignment="Center">
                                <Image Source="{StaticResource languageDrawingImage}" 
                                        Width="60" 
                                        Height="20"
                                        DockPanel.Dock="Left" />
                                <Label Content="{DynamicResource LanguageMenuSetting}" 
                                       Margin="-15,0,0,0"/>
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <controls:CustomToggleButton
                                            IsChecked="{Binding LanguageController, Mode=TwoWay}" 
                                            Height="30"
                                            LeftCase="RU"
                                            RightCase="EN">
                                </controls:CustomToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
