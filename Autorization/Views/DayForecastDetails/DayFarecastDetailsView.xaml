<UserControl x:Class="WeatherAppWPF.Views.DayFarecastDetails.DayForecastDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherAppWPF.Views.DayFarecastDetails"
             xmlns:model="clr-namespace:WeatherAppWPF.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:converters="clr-namespace:WeatherAppWPF.Resources.Converters">
    <UserControl.DataContext>
        <model:DayForecastModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <converters:WeatherCodeToIconConverter x:Key="WeatherCodeToIconConverter"/>
        <converters:WindDirectionConverter x:Key="WindDirectionConverter"/>
        <converters:TemperatureConverter x:Key="TemperatureConverter" />
        <converters:PressureConverter x:Key="PressureConverter"/>
        <converters:PrecipitationConverter x:Key="PrecipitationConverter"/>
        <converters:WindSpeedConverter x:Key="WindSpeedConverter"/>
    </UserControl.Resources>
    <Border CornerRadius="20" 
            Background="#FFFFFFFF" 
            BorderBrush="#FFEEEEEE" 
            BorderThickness="1" Margin="10">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="25,0,0,0">
                    <TextBlock Text="{Binding Path=WeekDay}" 
                               FontSize="16" 
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path=DataTime, StringFormat={}{0:dd MMMM}}" 
                               FontSize="14"
                               Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Column="0" Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <Image Source="{StaticResource locationDrawingImage}" 
                               Width="30"/>
                        <TextBlock Text="{Binding Path=Location}" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                    <ContentControl Template="{Binding Wheather, Converter={StaticResource WeatherCodeToIconConverter}}"
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center" 
                                     Width="84" 
                                     Height="84"/>
                </Grid>
                <Grid Grid.Column="0" Grid.Row="1">
                    <TextBlock Text="{Binding Path=MaxTemperature, Converter={StaticResource TemperatureConverter}}"                              
                               FontSize="36" 
                               FontWeight="Bold" 
                               Margin="25,0,0,0"
                               FontFamily="{StaticResource AileronUltraLightFont}" >
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="{Binding Path=Wheather}"
                       Margin="50,0,0,0">
                </TextBlock>
            </Grid>

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" 
                            Margin="50,0,0,0">
                    <ContentControl Template = "{Binding Path=WindDirection,Converter={StaticResource WindDirectionConverter}}">
                    </ContentControl>
                    <TextBlock Text = "{Binding Path=WindSpeed}" HorizontalAlignment = "Center" Margin="50,0,0,0"/>
                    <TextBlock Text = "{Binding Path=Weather}" HorizontalAlignment = "Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock>Скорость ветра</TextBlock>
                    <TextBlock Margin="10,0,0,0" Text="{Binding Path=WindSpeed, Converter={StaticResource WindSpeedConverter}}">
                    </TextBlock>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="5">
                <StackPanel Margin="20,0,0,0">
                    <TextBlock>Осадки</TextBlock>
                    <TextBlock Margin="60,0,0,0" 
            Text="{Binding Path=Precipitation, Converter={StaticResource PrecipitationConverter}}">
                    </TextBlock>
                </StackPanel>
               
            </Grid>
            <Grid Grid.Row="6">
                <StackPanel Margin="20,0,0,0">
                    <Image Source="{StaticResource pressureDrawingImage}" 
                           Width="25" 
                           Height="25"
                           HorizontalAlignment="Left"/>
                    <TextBlock 
                        Margin="60,0,0,0" 
                        Text="{Binding Path=Pressure, Converter={StaticResource PressureConverter}}">
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
