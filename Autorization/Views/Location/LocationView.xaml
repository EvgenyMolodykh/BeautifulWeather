<UserControl x:Class="WeatherAppWPF.Views.Location.LocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherAppWPF.Views.Location"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:vm="clr-namespace:WeatherAppWPF.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{DynamicResource Location}" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,10"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource SearchPlaceHolder}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,5"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="200,0,200,0">
                <Border BorderBrush="#FFFFFF"
                        BorderThickness="2" 
                        CornerRadius="20" 
                        Height="40"
                        Margin="5"
                        Background="#FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center">
                            <ComboBox IsEditable="True"
                                      Height="25"
                                      Width="300"
                                      IsTextSearchEnabled="True"
                                      Text="{Binding LocationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding SearchResults}"
                                      SelectedItem="{Binding SelectedLocation}">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource MainForeground}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,0,5,0"/>

                                            <Button Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Width="30"
                                                    Height="30"
                                                    Cursor="Hand"
                                                    ToolTip="Добавить в избранное"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">

                                                <Image Source="{StaticResource favorite_svgrepo_comDrawingImage}" Width="20"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="200,0,200,0">
            <TextBlock Text="{DynamicResource SelectLocation}"
                       FontWeight="SemiBold" 
                       Margin="0,10,0,5"/>
            <Border BorderBrush="#FFFFFF" 
                    BorderThickness="2" 
                    CornerRadius="20" 
                    Padding="10"
                    Margin="5"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedLocation.Name}" 
                               Foreground="{DynamicResource MainForeground}"
                               Grid.Column="1" 
                               Margin="10,0" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" 
                    Orientation="Vertical" 
                    Margin="200,0,200,0">
            <TextBlock Text="{DynamicResource FavouriteLocations}" 
                       FontWeight="SemiBold" 
                       Margin="0,10,0,5"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    CornerRadius="15" 
                    Padding="10"
                    Height="200"
                    Margin="5"
                    Background="#FFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding FavoriteLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Gray" 
                                            BorderThickness="2" 
                                            CornerRadius="10" 
                                            Background="#FFFFFF"
                                            Padding="2"
                                            Cursor="Hand">


                                        <Button Command="{Binding DataContext.SelectedFavoriteLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                    Text="{Binding Name}"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"/>


                                                <Button Grid.Column="1"
                                                        Content="✖"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="Red"
                                                        Width="20"
                                                        Height="20"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.DeleteFavoriteLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/> 
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>