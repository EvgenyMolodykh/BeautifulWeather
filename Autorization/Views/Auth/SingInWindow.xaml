<Window x:Class="WeatherAppWPF.SingInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherAppWPF"
        mc:Ignorable="d"
        Title="Вход в личный кабинет" 
        Height="300" 
        Width="400"
        Background="{DynamicResource DayMainWindowGradient}"
        x:Name="SingInWindowUser"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label x:Name="Login_Label" 
            Grid.Row="0" 
            Content="Вход" 
            Style="{StaticResource TextStyle}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label x:Name="Login_TextBlock"
                    Grid.Column="0"
                    Content="Логин:" 
                    Style="{StaticResource TextStyle}" 
                    HorizontalAlignment="Right"
                    Margin="80 0 0 0"/>
            <Border  Grid.Column="1"
                     Style="{StaticResource BorderStyle}"
                     Margin="10 0 0 0">
                <TextBox x:Name="RegLogin_TextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding Login}"/>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label x:Name="Password_TextBlock"
                     Grid.Column="0" 
                     Grid.Row="1"
                     Content="Пароль:" 
                     Style="{StaticResource TextStyle}"
                     Margin="80 0 0 0"/>
            <Border Grid.Column="1"
                    Style="{StaticResource BorderStyle}">
                <TextBox x:Name="RegPassword_TextBox"
                    Style="{StaticResource TextBoxStyle}"
                    Text="{Binding Password}"/>
            </Border>
        </Grid>
        <CheckBox x:Name="RememberMe_Chebox" Content="Запомнить меня" 
                  Grid.Row="3" 
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  IsChecked="{Binding RememberMe}"/>
        <Button x:Name="SingIn_Button"
             Grid.Row="4"
             Content="Войти"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Width="80"
             Height="30"
             Style="{StaticResource ButtonStyleRegistration}"
             Command="{Binding SignInCommand}"
             CommandParameter="{Binding ElementName=SingInWindowUser}"
             Background="#FF64CCF1"/>
    </Grid>
</Window>